# Copy to .env for local development. Values match docker-compose.yml.

# Web
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# API
API_PORT=4000

# PostgreSQL
DATABASE_URL=postgresql://resume_judge:resume_judge@localhost:5432/resume_judge

# Redis
REDIS_URL=redis://localhost:6379

# S3-compatible storage (MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=resumes
S3_ACCESS_KEY_ID=resume_judge
S3_SECRET_ACCESS_KEY=resume_judge_secret
S3_FORCE_PATH_STYLE=true

# LLM
LLM_PROVIDER=anthropic
LLM_MODEL=
ANTHROPIC_API_KEY=
